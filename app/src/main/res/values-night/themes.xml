<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.PDFToolkit" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Splash Theme (Dark) -->
    <style name="Theme.PDFToolkit.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0A0A0C</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.PDFToolkit</item>
    </style>

</resources>